# PostHog Analytics (get your key at https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — transactional and marketing email. Used by app/api/contact/route.ts.
# Sending domain proofshotpro.com is verified in Resend (DKIM + send-subdomain SPF/MX).
# Server-side only: never expose this as NEXT_PUBLIC_*, and never call Resend from
# the browser — the key would ship in the client bundle.
#
# Required in production. Without it the contact form returns a 500 and tells the
# sender to email directly — deliberately loud, because silently accepting mail we
# cannot send is the bug this route replaced.
#
# Addresses live in lib/site.ts (CONTACT_EMAIL, MAIL_FROM), not here.
RESEND_API_KEY=re_your_key_here
